# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ─── SMTP (Google Workspace) ─────────────────────────────────────────────────
# Use an App Password if 2FA is on: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=invites@yourdomain.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME="Manan from Productivity Shastra"
SMTP_FROM_EMAIL=invites@yourdomain.com
SMTP_REPLY_TO=support@unleashed.in

# ─── Cron / Vercel ───────────────────────────────────────────────────────────
# Secret used by Vercel Cron to authenticate the daily send endpoint
CRON_SECRET=replace_with_long_random_string
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ─── Daily-send tuning ───────────────────────────────────────────────────────
DAILY_BATCH_SIZE=900            # per-campaign target (the engine never emails the same contact twice in the same day)
CRON_BATCH_SIZE=40              # emails per cron tick — 40 × 24 hourly ticks = 960/day on Vercel Hobby
SEND_WINDOW_START_HOUR=9        # 9 AM IST
SEND_WINDOW_TIMEZONE=Asia/Kolkata
